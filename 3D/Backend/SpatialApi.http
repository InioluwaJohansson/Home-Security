@baseUrl = https://localhost:7190
@token = REPLACE_WITH_TOKEN_FROM_EXISTING_LOGIN
@propertyId = 1
@buildingId = 1
@floorId = 1

### Existing login endpoint (request body must match existing login DTO)
POST {{baseUrl}}/Home_Security/User/Login
Content-Type: application/json

{
  "REPLACE": "WITH EXISTING LOGIN DTO FIELDS"
}

### Create spatial property
POST {{baseUrl}}/Home_Security/Spatial/Properties
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Main Residence" }

### Create building
POST {{baseUrl}}/Home_Security/Spatial/Buildings
Authorization: Bearer {{token}}
Content-Type: application/json

{ "propertyId": {{propertyId}}, "name": "Main Building", "baseElevation": 0 }

### Create underground floor
POST {{baseUrl}}/Home_Security/Spatial/Floors
Authorization: Bearer {{token}}
Content-Type: application/json

{ "buildingId": {{buildingId}}, "name": "Underground", "levelIndex": -1, "elevation": -3.2, "defaultCeilingHeight": 2.7 }

### Bind existing section to floor
POST {{baseUrl}}/Home_Security/Spatial/Floors/{{floorId}}/sections
Authorization: Bearer {{token}}
Content-Type: application/json

{ "sectionId": 1 }

### Bind existing room directly to floor (only when existing Room.SectionId is null)
POST {{baseUrl}}/Home_Security/Spatial/Floors/{{floorId}}/rooms
Authorization: Bearer {{token}}
Content-Type: application/json

{ "roomId": 1, "sectionId": null }

### Create wall geometry
POST {{baseUrl}}/Home_Security/Spatial/Properties/{{propertyId}}/geometry
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "kind": 2,
  "name": "Garage north wall",
  "geometryJson": "{\"type\":\"polyline\",\"points\":[[0,0,0],[6,0,0]],\"segments\":[{\"height\":2.7,\"thickness\":0.2,\"curve\":\"line\"}]}",
  "height": 2.7,
  "thickness": 0.2
}

### Create a device placement (targetKind: 1 Door, 2 Window, 3 Light, 4 Camera, 5 Appliance, 6 External, 7 Utility)
POST {{baseUrl}}/Home_Security/Spatial/Placements
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "propertyId": {{propertyId}},
  "targetKind": 3,
  "targetId": 1,
  "parentKind": 5,
  "parentId": 1,
  "attachmentKind": 1,
  "positionX": 1.2, "positionY": 2.4, "positionZ": 0.8,
  "rotationX": 0, "rotationY": 0, "rotationZ": 0, "rotationW": 1,
  "scaleX": 1, "scaleY": 1, "scaleZ": 1,
  "width": 0.15, "height": 0.15, "depth": 0.08
}

### Fetch authorized scene
GET {{baseUrl}}/Home_Security/Spatial/Properties/{{propertyId}}/scene
Authorization: Bearer {{token}}

### Delete spatial placement only (does not delete the existing Light)
DELETE {{baseUrl}}/Home_Security/Spatial/Placements/1
Authorization: Bearer {{token}}
